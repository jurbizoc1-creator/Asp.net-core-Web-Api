@host = http://localhost:5200
@estudianteId = 1
@cursoId = 1
@docenteId = 1
@asignacionId = 1

### Estado de la API
GET {{host}}/

### Crear estudiantes (anota el ID devuelto en las variables superiores)
POST {{host}}/api/estudiantes
Content-Type: application/json

{ "nombres": "Juan", "apellidos": "Pérez", "direccion": "Ciudad de Guatemala" }

### Listar estudiantes
GET {{host}}/api/estudiantes

### Consultar por ID
GET {{host}}/api/estudiantes/{{estudianteId}}

### Actualizar
PUT {{host}}/api/estudiantes/{{estudianteId}}
Content-Type: application/json

{ "estudianteId": {{estudianteId}}, "nombres": "Juan", "apellidos": "Pérez", "direccion": "Ciudad de Guatemala" }

### Crear cursos (anota el ID devuelto en las variables superiores)
POST {{host}}/api/cursos
Content-Type: application/json

{ "nombre": "Programación Web" }

### Listar cursos
GET {{host}}/api/cursos

### Consultar por ID
GET {{host}}/api/cursos/{{cursoId}}

### Actualizar
PUT {{host}}/api/cursos/{{cursoId}}
Content-Type: application/json

{ "cursoId": {{cursoId}}, "nombre": "Programación Web" }

### Crear docentes (anota el ID devuelto en las variables superiores)
POST {{host}}/api/docentes
Content-Type: application/json

{ "nombres": "Ana", "apellidos": "López" }

### Listar docentes
GET {{host}}/api/docentes

### Consultar por ID
GET {{host}}/api/docentes/{{docenteId}}

### Actualizar
PUT {{host}}/api/docentes/{{docenteId}}
Content-Type: application/json

{ "docenteId": {{docenteId}}, "nombres": "Ana", "apellidos": "López" }

### Crear asignaciones (anota el ID devuelto en las variables superiores)
POST {{host}}/api/asignaciones
Content-Type: application/json

{ "estudianteId": {{estudianteId}}, "cursoId": {{cursoId}}, "docenteId": {{docenteId}} }

### Listar asignaciones
GET {{host}}/api/asignaciones

### Consultar por ID
GET {{host}}/api/asignaciones/{{asignacionId}}

### Actualizar
PUT {{host}}/api/asignaciones/{{asignacionId}}
Content-Type: application/json

{ "asignacionId": {{asignacionId}}, "estudianteId": {{estudianteId}}, "cursoId": {{cursoId}}, "docenteId": {{docenteId}} }

### Eliminar primero la asignación
DELETE {{host}}/api/asignaciones/{{asignacionId}}

### Eliminar estudiante
DELETE {{host}}/api/estudiantes/{{estudianteId}}

### Eliminar curso
DELETE {{host}}/api/cursos/{{cursoId}}

### Eliminar docente
DELETE {{host}}/api/docentes/{{docenteId}}

